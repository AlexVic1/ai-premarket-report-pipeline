# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# The inbox(es) that should receive the premarket report. One address, or
# several separated by commas, e.g. EMAIL_TO=you@example.com,friend@example.com
EMAIL_TO=

# Optional, who the report appears to come from, defaults to
# "AI Premarket Analyst <onboarding@resend.dev>" if left blank. If you've
# verified a domain in Resend you can use an address on it instead.
EMAIL_FROM=

# Optional additional Resend accounts, for recipients on a different Resend
# sandbox account than the one above (see deliver.py's docstring for why this
# is needed until a domain is verified). Numbered _2, _3, and so on, each is
# a full separate RESEND_API_KEY / EMAIL_TO / EMAIL_FROM set.
# RESEND_API_KEY_2=
# EMAIL_TO_2=
# EMAIL_FROM_2=

# The Claude analyst + merge pass (claude_analyst.py) does NOT use an API key.
# It runs through the Claude Code CLI (`claude -p`), authenticated via your
# Claude Pro/Max subscription login. Run `claude auth login` once, `claude
# auth status` to check. If the CLI isn't installed or isn't logged in,
# run_daily.py just skips the AI Premarket Report and sends the two
# mechanical reports (Stage 2 Rider, FinViz Sector Scan) instead.
